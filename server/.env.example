# MongoDB Connection String
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/vetnova?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5001

# Cloudinary Configuration (Option 1: Individual Credentials - RECOMMENDED)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudinary Configuration (Option 2: Connection String URL)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
